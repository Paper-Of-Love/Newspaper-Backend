# Copy this file to .env and fill in real values before running the server.

# Shared password writers use to log into the Typewriter app.
WRITER_PASSWORD=change-me-writer

# Shared password editors use to log into the Editor Controller app.
EDITOR_PASSWORD=change-me-editor

# Secret used to sign session tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on.
PORT=4000

# Comma-separated list of origins allowed to make requests (the frontends).
# Reader View runs on 8420, Typewriter on 8422, Editor Controller on 8423.
ALLOWED_ORIGINS=http://localhost:8420,http://localhost:8422,http://localhost:8423
